# Copy to .env (make setup does this). With everything blank the app runs on mock data.

# Databricks: set all three to switch the API from mock to real tables (or force with REALDEAL_MOCK=0/1).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Extraction: set to use Claude for receipts/products/manual. EXTRACTOR=mock|claude|databricks overrides.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Max /intake/* calls per client IP per hour (they spend API credits).
# INTAKE_LIMIT_PER_HOUR=30
# INTAKE_GLOBAL_LIMIT_PER_HOUR=300

# How often to check for a new flyer week and re-match every saved item (Databricks mode only). 0 = off.
# REMATCH_EVERY_SECONDS=300

# Voice: blank returns a canned transcript.
ELEVENLABS_API_KEY=
