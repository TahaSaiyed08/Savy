# Copy to .env (make setup does this). With everything blank the app runs on mock data.

# Databricks: set all three to switch the API from mock to real tables (or force with REALDEAL_MOCK=0/1).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Extraction: set to use Claude for receipts/products/manual. EXTRACTOR=mock|claude|databricks overrides.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# EXTRACTOR=databricks runs ai_query on the warehouse instead (opt-in: slower, weaker on receipts than Claude).
# DATABRICKS_EXTRACT_MODEL=databricks-llama-4-maverick

# Gemini (MLH prize): EXTRACTOR=gemini reads receipts, photos and typed text with Google's Gemini API. With only this key
# set (no ANTHROPIC_API_KEY) it is picked automatically.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Max /intake/* calls per client IP per hour (they spend API credits).
# INTAKE_LIMIT_PER_HOUR=30
# INTAKE_GLOBAL_LIMIT_PER_HOUR=300

# Voice: blank returns a canned transcript.
ELEVENLABS_API_KEY=

# Flyers: mock mode pulls this week's real flyers from Flipp for the shopper's postal code.
# DEFAULT_POSTAL_CODE=V6T1Z4  # used until the shopper sets their own
# REALDEAL_LIVE_FLYERS=0      # serve the small canned flyer list instead (offline, tests)

# Databricks + Genie (all optional, see README "Databricks and Genie"). Run `make databricks-setup` once first.
# REALDEAL_DATABRICKS_SYNC=1   # push every flyer refresh into realdeal.core.live_listings / price_history
# GENIE_SPACE_ID=              # normally saved by `make databricks-setup` in apps/api/data/genie_space.json
# ASK_LIMIT_PER_HOUR=20        # questions per client per hour (each one runs a warehouse query)
